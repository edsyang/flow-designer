{
  "name": "flow-designer",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "engines": {
    "node": ">=18.12.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:bpmn": "pnpm --filter @flow-designer/bpmn-app dev",
    "dev:comfyui": "pnpm --filter @flow-designer/comfyui-app dev",
    "dev:er": "pnpm --filter @flow-designer/er-app dev",
    "dev:e2e:bpmn": "pnpm --filter @flow-designer/bpmn-app exec vite --host 127.0.0.1 --port 5179",
    "dev:e2e:comfyui": "pnpm --filter @flow-designer/comfyui-app exec vite --host 127.0.0.1 --port 5180",
    "dev:e2e:er": "pnpm --filter @flow-designer/er-app exec vite --host 127.0.0.1 --port 5181",
    "start": "pnpm dev:bpmn",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:core-baseline": "node scripts/check-core-baseline.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^5",
    "jsdom": "^25.0.0",
    "less": "^4.9.1",
    "prettier": "^3.9.10",
    "turbo": "^2.9.14",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4",
    "vitest": "^2.1.9"
  }
}

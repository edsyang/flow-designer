{
  "name": "@flow-designer/plugins",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@flow-designer/core": "workspace:*",
    "@flow-designer/graph": "workspace:*",
    "@flow-designer/model": "workspace:*",
    "@flow-designer/react": "workspace:*",
    "@flow-designer/skeleton": "workspace:*",
    "mobx-react-lite": "^4.0.0"
  },
  "peerDependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.2",
    "mobx": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@antv/x6": "^2.18.0",
    "@types/react": "catalog:",
    "antd": "^6.5.2",
    "mobx": "^6.13.7"
  }
}

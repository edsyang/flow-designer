{
  "name": "@flow-designer/engine",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/ --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@flow-designer/model": "workspace:*",
    "@flow-designer/core": "workspace:*",
    "@flow-designer/skeleton": "workspace:*",
    "@flow-designer/graph": "workspace:*",
    "@flow-designer/plugins": "workspace:*",
    "@flow-designer/setters": "workspace:*",
    "@flow-designer/react": "workspace:*",
    "mobx": "^6.13.7",
    "@flow-designer/i18n": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "antd": "^6.5.2"
  }
}

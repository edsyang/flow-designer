{
  "name": "@flow-designer/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/ --max-warnings 47",
    "typecheck": "tsc --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@flow-designer/model": "workspace:*",
    "eventemitter3": "^5.0.0"
  },
  "peerDependencies": {
    "mobx": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:"
  }
}

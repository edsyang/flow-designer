{
  "name": "@flow-designer/er-nodes",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./i18n": {
      "source": "./src/i18n.ts",
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.mjs",
      "require": "./dist/i18n.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@flow-designer/model": "workspace:*",
    "@flow-designer/setters": "workspace:*",
    "react": "^18.3.1",
    "@flow-designer/graph": "workspace:*"
  },
  "dependencies": {
    "@flow-designer/i18n": "workspace:*",
    "@flow-designer/engine": "workspace:*"
  }
}
